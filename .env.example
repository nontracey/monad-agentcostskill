# 用户主钱包私钥（Agent 永远拿不到）
MAIN_PRIVATE_KEY=

# Monad 测试网 RPC
MONAD_RPC_URL=https://testnet-rpc.monad.xyz/

# 链 ID（测试网 10143，主网 143）
CHAIN_ID=10143

# USDC 合约地址（MPP 支付用，留空则 fallback 到 MON 直转）
USDC_CONTRACT=

# 初始策略
DAILY_LIMIT=1.0
SINGLE_LIMIT=0.5
ALLOWED_TOKENS=MON

# Phase 3: 通知
DISCORD_WEBHOOK_URL=

# Phase 3: 策略扩展（可通过 policies.json 配置）
# TIME_WINDOW_ENABLED=false
# TIME_WINDOW_START=9
# TIME_WINDOW_END=18
